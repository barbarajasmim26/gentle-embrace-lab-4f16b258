# Porta local em que o servidor irá escutar
WPP_PORT=3333

# Nome da sessão do WhatsApp (mantenha o mesmo para reaproveitar o login)
WPP_SESSION_NAME=mesquita

# URL pública que receberá mensagens recebidas (opcional). Pode ser uma rota
# do próprio frontend ou uma Edge Function que grava no Supabase. Se vazio,
# o servidor salva direto no Supabase usando as variáveis abaixo.
WPP_WEBHOOK_URL=

# Token simples para proteger os endpoints (envie no header X-Api-Key)
WPP_API_KEY=troque-este-token

# Supabase (usado para gravar mensagens recebidas no banco)
SUPABASE_URL=https://qvnfifgnadxmevatwdxm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key

# CORS — origem do frontend (use * para liberar tudo em dev)
CORS_ORIGIN=*
